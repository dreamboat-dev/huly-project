# To disable signups set to true
DISABLE_SIGNUP=false

# Container restart policy
RESTART_POLICY=unless-stopped

# The address of the host or server from which you will access your Huly instance.
# This can be a domain name (e.g., huly.example.com) or an IP address (e.g., 192.168.1.1).

# ============================ #
# Replace with your IP Address #
# ============================ #
HOST_ADDRESS=10.0.0.1

# Set this variable to 'true' to enable SSL (HTTPS/WSS). 
# Leave it empty to use non-SSL (HTTP/WS).
SECURE=

# Port to access the Huly instance via Nginx
HTTP_PORT=80

# Huly specific variables
TITLE=Huly
DEFAULT_LANGUAGE=en
LAST_NAME_FIRST=true

# Secret for authenticating communication between the containers

# ============================================================= #
# Replace with a secret generated by you (openssl rand -hex 32) #
# ============================================================= #
HULY_SECRET=

# === IMAGE TAGS ===
NGINX_IMAGE_TAG=1.21.3
MONGODB_IMAGE_TAG=7-jammy
MINIO_IMAGE_TAG=RELEASE.2025-05-24T17-08-30Z
ELASTIC_IMAGE_TAG=7.14.2
HULY_IMAGE_TAG=v0.6.501

# === NAMES ===
NGINX_NAME=huly-nginx
MONGODB_NAME=huly-mongodb
MINIO_NAME=huly-minio
ELASTIC_NAME=huly-elastic
REKONI_NAME=huly-rekoni
TRANSACTOR_NAME=huly-transactor
COLLABORATOR_NAME=huly-collaborator
ACCOUNT_NAME=huly-account
WORKSPACE_NAME=huly-workspace
FRONT_NAME=huly-front
FULLTEXT_NAME=huly-fulltext
STATS_NAME=huly-stats

# === AUTHENTICATION ===
MINIO_ROOT_USER=huly
# ======================================== #
# Replace with a password generated by you #
# Take care to only use allowed characters #
# ======================================== #
MINIO_ROOT_PASSWORD=REPLACE_ME

# === STORAGE ===
STORAGE_BASE_PATH=./storage